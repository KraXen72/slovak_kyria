{
  // vial-qmk build environment for Kyria rev1 (AVR / Elite-C)
  // Targets: vial-kb/vial-qmk @ bdbfe65 (legacy, ~4 years old)
  //
  // Usage with dcman:
  //   dcman shell           — open shell in container
  //   dcman rebuild         — full rebuild after devcontainer.json changes
  //   dcman kill            — stop container
  //
  // Usage without dcman:
  //   devcontainer up --workspace-folder .
  //   devcontainer exec --workspace-folder . bash

  "name": "vial-qmk (kyria-avr)",

  // Fedora base image — same distro as host.
  // Using a specific digest/tag here would make this fully reproducible;
  // for now "latest" is fine since QMK tools pin their own versions.
  "image": "ghcr.io/kraxen72/fedora-toolchain-base:latest",

  // Mount the vial-qmk repo root into the container.
  // Change localWorkspaceFolder if your vial-qmk checkout lives elsewhere.
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/workspaces/${localWorkspaceFolderBasename},type=bind,Z",
  "workspaceFolder": "/home/vscode/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    // Bash prompt with git branch indicator
    "ghcr.io/kraxen72/devcontainer-features/common-utils-bash-prompt:1": {},
    // Python (for helpercli.py / uv)
    "ghcr.io/kraxen72/devcontainer-features/python-minimal:1": {}
  },

  // Install QMK CLI, AVR toolchain, dfu-programmer, and uv once on first build.
  // qmk setup is run non-interactively; it will clone submodules into the
  // mounted workspace so they persist across rebuilds.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  "runArgs": [
    "--name=dcman-${localWorkspaceFolderBasename}",

    // Publish SSH port so dcman zed / external SSH access works.
    // Requires the ssh-zed feature or equivalent (Dropbear inside container).
    "--publish=127.0.0.1:${localEnv:DCMAN_SSH_PORT:2222}:2222",

    // Drop all capabilities — QMK compilation and DFU flashing don't need any.
    // NOTE: flashing via dfu-programmer is intended to run on the HOST,
    // not inside the container (USB passthrough is fragile and unnecessary).
    // The compiled .hex lives in the mounted workspace; flash it from the host.
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--tmpfs=/tmp:exec,mode=1777",
    "--pids-limit=2048",
    "--ulimit=nproc=2048:2048",
    "--ulimit=nofile=65536:65536"
  ]
}
